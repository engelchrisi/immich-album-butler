# Copy to /etc/immich-album-butler/immich-album-butler.env
#   chown root:immich-album-butler  &&  chmod 640
#
# This file holds the only secrets the butler has. It is referenced from the
# systemd units with EnvironmentFile, so the values never appear on a command
# line and are not visible to other users through `ps`.

# An Immich API key. Scopes it needs:
#   asset.read, asset.view, person.read, album.read, album.create,
#   albumAsset.create, albumAsset.delete
# albumAsset.delete is needed because every album mirrors its rule: an asset
#   that stops matching is removed from the album (never from the library).
# Add album.update if you set a cover, use the marker suffix, or set
#   describe = "hint" (the description hint line, N31).
# Add user.read + albumUser.create (and albumUser.update to change a role) only
#   if you share albums.
IMMICH_KEY=

# Design mode's login does NOT live here. It is a [[design.users]] entry in
# config.toml holding an scrypt hash, so no password is stored anywhere:
#
#   immich-album-butler passwd <name>
#
# prints the block to paste in.
